{
  "name": "voltech-marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev --workspace=@voltech/customer",
    "dev:seller": "npm run dev --workspace=@voltech/seller",
    "dev:admin": "npm run dev --workspace=@voltech/admin",
    "build:customer": "npm run build --workspace=@voltech/customer",
    "build:seller": "npm run build --workspace=@voltech/seller",
    "build:admin": "npm run build --workspace=@voltech/admin",
    "lint:customer": "npm run lint --workspace=@voltech/customer",
    "lint:seller": "npm run lint --workspace=@voltech/seller",
    "lint:admin": "npm run lint --workspace=@voltech/admin",
    "db:generate": "npm run generate --workspace=@voltech/database",
    "db:migrate": "npm run migrate --workspace=@voltech/database",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@voltech/database",
    "db:studio": "npm run studio --workspace=@voltech/database",
    "db:seed": "npm run seed --workspace=@voltech/database"
  }
}
